import CRNT.Algebra.SteadyStateIdeal
import CRNT.Stochastic.ACRExtinctionExample
import Mathlib.RingTheory.MvPolynomial.Groebner
import Mathlib.Algebra.MvPolynomial.Funext
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.Algebra.Polynomial.AlgebraMap

/-!
# Elimination in the steady-state ideal

The steady-state ideal `I_κ ⊆ ℝ[x_s : s ∈ S]` of a mass-action network
(`Network.steadyStateIdeal`) is generated by the species polynomials `f_s`. Elimination studies
`I_κ ∩ ℝ[x_t : t ∈ T]` and, for positive steady states, the saturation of `I_κ` by monomials. In
CRNT it is used to certify absolute concentration robustness and to bound the number of
steady-state values of a species (Pascual-Escudero–Feliu 2021; Karp–Pérez Millán–Dasgupta–
Dickenstein–Gunawardena 2012; Dickenstein 2016). This module proves the parts of that method that
do not need Gröbner-basis computations.

* `eval_eq_zero_of_mem_steadyStateIdeal`: every element of `I_κ` vanishes at every steady state.
* `eval_eq_zero_of_monomial_mul_mem`: if `x^m · p ∈ I_κ`, then `p` vanishes at every positive steady
  state (saturation by monomials).
* `eliminationIdeal`, `eval_restrict_eq_zero_of_mem_eliminationIdeal`: the elimination ideal
  `I ∩ ℝ[x_T]` vanishes on the projection of the steady states (the easy inclusion of the closure
  theorem).
* `eval_eq_zero_of_univariate_mem`, `finite_steadyStateValues_of_univariate_mem`: a nonzero
  univariate eliminant `x^m · q(x_s) ∈ I_κ` confines the values `x_s` at positive steady states to
  the roots of `q`; there are at most `deg q` of them.
* `acr_of_univariate_mem`: if moreover `q` has exactly one positive root `c`, the network has
  absolute concentration robustness in `s` with value `c`.
* `exists_remainder_eval_eq`: the multivariate division algorithm of Mathlib
  (`MonomialOrder.div`) reduces any polynomial to a remainder that agrees with it on the
  steady-state variety and has no term divisible by a leading monomial of a generator.
* `ACRExample.steadyStatePolynomial_B_eq`, `ACRExample.acr_by_elimination`: for
  `A + B → 2B`, `B → A`, the generator `f_B` is `x_B (κ₀ x_A − κ₁)`, which certifies ACR in `A`.

Not formalized: Buchberger's algorithm, Gröbner bases and the elimination theorem
(`G ∩ ℝ[x_T]` is a Gröbner basis of the elimination ideal for a lexicographic order).
-/

namespace CRNT

namespace Network

open MvPolynomial

open scoped BigOperators

variable {S : Type} [DecidableEq S] [Fintype S]

/-- **The steady-state ideal vanishes at steady states.** -/
theorem eval_eq_zero_of_mem_steadyStateIdeal (N : Network S) (κ : N.RateConstants)
    {x : Concentration S} (hx : N.IsMassActionSteadyState κ x) {p : MvPolynomial S ℝ}
    (hp : p ∈ N.steadyStateIdeal κ) : eval x p = 0 := by
  have hle : N.steadyStateIdeal κ ≤ RingHom.ker (eval x) := by
    rw [steadyStateIdeal, Ideal.span_le]
    rintro _ ⟨s, rfl⟩
    show eval x (N.steadyStatePolynomial κ s) = 0
    rw [eval_steadyStatePolynomial]
    exact hx s
  exact RingHom.mem_ker.mp (hle hp)

/-- **Saturation by monomials.** If `x^m · p ∈ I_κ`, then `p` vanishes at every positive steady
state. -/
theorem eval_eq_zero_of_monomial_mul_mem (N : Network S) (κ : N.RateConstants)
    {x : Concentration S} (hx : N.IsMassActionSteadyState κ x) (hpos : x.Positive)
    {m : S →₀ ℕ} {p : MvPolynomial S ℝ} (hp : monomial m 1 * p ∈ N.steadyStateIdeal κ) :
    eval x p = 0 := by
  have h := N.eval_eq_zero_of_mem_steadyStateIdeal κ hx hp
  rw [eval_mul, eval_monomial, one_mul] at h
  have hm : (m.prod fun n e => x n ^ e) ≠ 0 := by
    rw [Finsupp.prod]
    exact Finset.prod_ne_zero_iff.mpr fun a _ => pow_ne_zero _ (hpos a).ne'
  exact (mul_eq_zero.mp h).resolve_left hm

/-- The **elimination ideal** of `I` for the species in `T`: the polynomials of `I` involving only
the variables `x_t`, `t ∈ T`, as polynomials in those variables. -/
noncomputable def eliminationIdeal (I : Ideal (MvPolynomial S ℝ)) (T : Set S) :
    Ideal (MvPolynomial T ℝ) :=
  I.comap (rename (Subtype.val : T → S))

/-- **Projection of the steady states lies in the zero set of the elimination ideal.** -/
theorem eval_restrict_eq_zero_of_mem_eliminationIdeal (N : Network S) (κ : N.RateConstants)
    {x : Concentration S} (hx : N.IsMassActionSteadyState κ x) {T : Set S}
    {q : MvPolynomial T ℝ} (hq : q ∈ eliminationIdeal (N.steadyStateIdeal κ) T) :
    eval (fun t : T => x t) q = 0 := by
  have h := N.eval_eq_zero_of_mem_steadyStateIdeal κ hx (Ideal.mem_comap.mp hq)
  rwa [eval_rename] at h

omit [DecidableEq S] [Fintype S] in
/-- Evaluating a univariate polynomial in the variable `x_s`. -/
theorem eval_aeval_X (x : Concentration S) (s : S) (q : Polynomial ℝ) :
    eval x (Polynomial.aeval (X s : MvPolynomial S ℝ) q) = q.eval (x s) := by
  have h := Polynomial.aeval_algHom_apply (MvPolynomial.aeval x : MvPolynomial S ℝ →ₐ[ℝ] ℝ)
    (X s) q
  rw [MvPolynomial.aeval_X, Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map] at h
  simp only [Algebra.algebraMap_self, Polynomial.map_id] at h
  rw [h]; rfl

/-- **A univariate eliminant constrains the species value.** If `x^m · q(x_s) ∈ I_κ`, then
`q(x_s) = 0` at every positive steady state. -/
theorem eval_eq_zero_of_univariate_mem (N : Network S) (κ : N.RateConstants) {s : S}
    {m : S →₀ ℕ} {q : Polynomial ℝ}
    (hmem : monomial m 1 * Polynomial.aeval (X s : MvPolynomial S ℝ) q ∈ N.steadyStateIdeal κ)
    {x : Concentration S} (hx : N.IsMassActionSteadyState κ x) (hpos : x.Positive) :
    q.eval (x s) = 0 := by
  rw [← eval_aeval_X]
  exact N.eval_eq_zero_of_monomial_mul_mem κ hx hpos hmem

/-- **Finitely many steady-state values.** If a nonzero `q` gives `x^m · q(x_s) ∈ I_κ`, the values
of `x_s` at positive steady states form a finite set with at most `deg q` elements. -/
theorem finite_steadyStateValues_of_univariate_mem (N : Network S) (κ : N.RateConstants) {s : S}
    {m : S →₀ ℕ} {q : Polynomial ℝ} (hq : q ≠ 0)
    (hmem : monomial m 1 * Polynomial.aeval (X s : MvPolynomial S ℝ) q ∈ N.steadyStateIdeal κ) :
    {c : ℝ | ∃ x : Concentration S, x.Positive ∧ N.IsMassActionSteadyState κ x ∧ x s = c}.Finite ∧
      {c : ℝ | ∃ x : Concentration S, x.Positive ∧ N.IsMassActionSteadyState κ x ∧
        x s = c}.ncard ≤ q.natDegree := by
  have hsub : {c : ℝ | ∃ x : Concentration S, x.Positive ∧ N.IsMassActionSteadyState κ x ∧
      x s = c} ⊆ (q.roots.toFinset : Set ℝ) := by
    rintro c ⟨x, hpos, hx, rfl⟩
    simp only [Finset.mem_coe, Multiset.mem_toFinset]
    exact (Polynomial.mem_roots hq).mpr (N.eval_eq_zero_of_univariate_mem κ hmem hx hpos)
  refine ⟨(Finset.finite_toSet _).subset hsub, ?_⟩
  calc _ ≤ (q.roots.toFinset : Set ℝ).ncard := Set.ncard_le_ncard hsub (Finset.finite_toSet _)
    _ = q.roots.toFinset.card := Set.ncard_coe_finset _
    _ ≤ Multiset.card q.roots := Multiset.toFinset_card_le _
    _ ≤ q.natDegree := Polynomial.card_roots' q

/-- **ACR from a univariate eliminant.** If `x^m · q(x_s) ∈ I_κ` and `c` is the only positive root
of `q`, every positive steady state has `x_s = c`. -/
theorem acr_of_univariate_mem (N : Network S) (κ : N.RateConstants) {s : S} {m : S →₀ ℕ}
    {q : Polynomial ℝ} {c : ℝ}
    (hmem : monomial m 1 * Polynomial.aeval (X s : MvPolynomial S ℝ) q ∈ N.steadyStateIdeal κ)
    (hroot : ∀ y : ℝ, 0 < y → q.eval y = 0 → y = c) {x : Concentration S}
    (hx : N.IsMassActionSteadyState κ x) (hpos : x.Positive) : x s = c :=
  hroot _ (hpos s) (N.eval_eq_zero_of_univariate_mem κ hmem hx hpos)

/-- **Division by the steady-state generators.** For a monomial order `ord`, every polynomial `f`
has a remainder `r`, no term of which is divisible by the leading monomial of a nonzero generator
`f_s`, that agrees with `f` at every steady state. -/
theorem exists_remainder_eval_eq (N : Network S) (κ : N.RateConstants) (ord : MonomialOrder S)
    (f : MvPolynomial S ℝ) :
    ∃ r : MvPolynomial S ℝ,
      (∀ c ∈ r.support, ∀ s, N.steadyStatePolynomial κ s ≠ 0 →
        ¬ ord.degree (N.steadyStatePolynomial κ s) ≤ c) ∧
      ∀ x, N.IsMassActionSteadyState κ x → eval x f = eval x r := by
  let b : {s : S // N.steadyStatePolynomial κ s ≠ 0} → MvPolynomial S ℝ :=
    fun s => N.steadyStatePolynomial κ s
  have hb : ∀ i, IsUnit (ord.leadingCoeff (b i)) := fun i =>
    isUnit_iff_ne_zero.mpr (ord.leadingCoeff_ne_zero_iff.mpr i.2)
  obtain ⟨g, r, hf, -, hr⟩ := ord.div hb f
  refine ⟨r, fun c hc s hs => hr c hc ⟨s, hs⟩, fun x hx => ?_⟩
  have hmem : Finsupp.linearCombination (MvPolynomial S ℝ) b g ∈ N.steadyStateIdeal κ := by
    rw [Finsupp.linearCombination_apply]
    exact Submodule.sum_mem _ fun i _ =>
      Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i.1, rfl⟩)
  rw [hf, eval_add, N.eval_eq_zero_of_mem_steadyStateIdeal κ hx hmem, zero_add]

end Network

namespace ACRExample

open MvPolynomial Network

/-- For `A + B → 2B`, `B → A`, the steady-state polynomial of `B` is `x_B · (κ₀ x_A − κ₁)`. -/
theorem steadyStatePolynomial_B_eq (κ : net.RateConstants) :
    net.steadyStatePolynomial κ 1 =
      monomial (Finsupp.single 1 1) 1 *
        Polynomial.aeval (X 0 : MvPolynomial (Fin 2) ℝ)
          (Polynomial.C (κ.k (0 : Fin 2)) * Polynomial.X - Polynomial.C (κ.k (1 : Fin 2))) := by
  apply MvPolynomial.funext
  intro x
  rw [eval_steadyStatePolynomial, eval_mul, eval_aeval_X, eval_monomial,
    Network.massActionVectorField_apply, sum_R]
  simp [massActionRate, reactionVector, r0, r1, Complex.massActionMonomial, Fin.prod_univ_two,
    Finsupp.prod_single_index]
  ring

/-- **ACR by elimination.** The univariate eliminant `κ₀ x_A − κ₁` (saturated by `x_B`) shows that
every positive steady state has `x_A = κ₁ / κ₀`. -/
theorem acr_by_elimination (κ : net.RateConstants) {x : Concentration (Fin 2)}
    (hx : net.IsMassActionSteadyState κ x) (hpos : x.Positive) :
    x 0 = κ.k (1 : Fin 2) / κ.k (0 : Fin 2) := by
  have hmem : monomial (Finsupp.single 1 1) 1 *
      Polynomial.aeval (X 0 : MvPolynomial (Fin 2) ℝ)
        (Polynomial.C (κ.k (0 : Fin 2)) * Polynomial.X - Polynomial.C (κ.k (1 : Fin 2))) ∈ net.steadyStateIdeal κ := by
    rw [← steadyStatePolynomial_B_eq]
    exact Ideal.subset_span ⟨1, rfl⟩
  refine net.acr_of_univariate_mem κ hmem (fun y _ hy => ?_) hx hpos
  have hk := (κ.positive (0 : Fin 2)).ne'
  simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C,
    Polynomial.eval_X] at hy
  field_simp
  linarith

end ACRExample

end CRNT
