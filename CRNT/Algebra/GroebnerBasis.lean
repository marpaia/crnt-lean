import Mathlib.RingTheory.MvPolynomial.Groebner
import Mathlib.Algebra.MvPolynomial.Supported
import Mathlib.Data.Finsupp.MonomialOrder
import Mathlib.Data.Finsupp.Lex
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Gröbner bases: ideal membership and elimination

Mathlib provides the multivariate division algorithm (`MonomialOrder.div`). This module adds the
two theorems of Gröbner-basis theory used for steady-state ideals (Cox–Little–O'Shea, *Ideals,
Varieties, and Algorithms*, §2.6 and §3.1).

A family `b` in an ideal `I` is a **Gröbner basis** of `I` for a monomial order `m` when the
leading monomial of every nonzero element of `I` is divisible by the leading monomial of some
`b i` (`IsGroebnerBasis`).

* `IsGroebnerBasis.mem_iff_remainder_eq_zero`: for any division `f = ∑ g_i b_i + r` whose
  remainder has no term divisible by a leading monomial of `b`, `f ∈ I` iff `r = 0`.
* `IsGroebnerBasis.span_eq`: a Gröbner basis (with unit leading coefficients) generates `I`.
* `IsEliminationOrder`, `IsGroebnerBasis.elimination`: **elimination theorem**. For an order in
  which every monomial below a monomial in the variables `T` is again in the variables `T`, the
  elements of a Gröbner basis of `I` that involve only `T` form a Gröbner basis of
  `I ∩ R[T]`, and they generate every element of `I ∩ R[T]`.
* `lex_isEliminationOrder`: the lexicographic order eliminates the smallest variables, i.e. it is
  an elimination order for every upward-closed set of variables.
* `exists_isGroebnerBasis`: over a field with finitely many variables, every ideal has a finite
  Gröbner basis (the leading-monomial ideal is finitely generated by Hilbert's basis theorem).

Buchberger's criterion and algorithm (computing Gröbner bases from `S`-polynomials) are not
formalized.
-/

namespace CRNT

namespace Groebner

open MvPolynomial MonomialOrder

variable {σ : Type*} {R : Type*} [CommRing R] (m : MonomialOrder σ)

/-- `b` is a **Gröbner basis** of `I` for the monomial order `m`. -/
def IsGroebnerBasis {ι : Type*} (b : ι → MvPolynomial σ R) (I : Ideal (MvPolynomial σ R)) :
    Prop :=
  (∀ i, b i ∈ I) ∧ ∀ f ∈ I, f ≠ 0 → ∃ i, m.degree (b i) ≤ m.degree f

variable {m}

/-- **Ideal membership by division.** -/
theorem IsGroebnerBasis.mem_iff_remainder_eq_zero {ι : Type*} {b : ι → MvPolynomial σ R}
    {I : Ideal (MvPolynomial σ R)} (hG : IsGroebnerBasis m b I) {f r : MvPolynomial σ R}
    {g : ι →₀ MvPolynomial σ R}
    (hdiv : f = Finsupp.linearCombination (MvPolynomial σ R) b g + r)
    (hr : ∀ c ∈ r.support, ∀ i, ¬ m.degree (b i) ≤ c) : f ∈ I ↔ r = 0 := by
  have hlc : Finsupp.linearCombination (MvPolynomial σ R) b g ∈ I := by
    rw [Finsupp.linearCombination_apply]
    exact Submodule.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hG.1 i)
  constructor
  · intro hf
    by_contra hr0
    have hrI : r ∈ I := by
      have : r = f - Finsupp.linearCombination (MvPolynomial σ R) b g := by rw [hdiv]; ring
      rw [this]; exact I.sub_mem hf hlc
    obtain ⟨i, hi⟩ := hG.2 r hrI hr0
    exact hr _ ((m.degree_mem_support_iff r).mpr hr0) i hi
  · intro h
    rw [hdiv, h, add_zero]
    exact hlc

/-- **A Gröbner basis generates the ideal.** -/
theorem IsGroebnerBasis.span_eq {ι : Type*} {b : ι → MvPolynomial σ R}
    {I : Ideal (MvPolynomial σ R)} (hG : IsGroebnerBasis m b I)
    (hb : ∀ i, IsUnit (m.leadingCoeff (b i))) : Ideal.span (Set.range b) = I := by
  apply le_antisymm
  · rw [Ideal.span_le]; rintro _ ⟨i, rfl⟩; exact hG.1 i
  · intro f hf
    obtain ⟨g, r, hdiv, -, hr⟩ := m.div hb f
    have hr0 := (hG.mem_iff_remainder_eq_zero hdiv hr).mp hf
    rw [hdiv, hr0, add_zero, Finsupp.linearCombination_apply]
    exact Submodule.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- `m` is an **elimination order** for the variables `T`: every monomial below a monomial in the
variables `T` is again a monomial in the variables `T`. -/
def IsEliminationOrder (m : MonomialOrder σ) (T : Set σ) : Prop :=
  ∀ d d' : σ →₀ ℕ, (∀ x ∈ d.support, x ∈ T) → m.toSyn d' ≤ m.toSyn d → ∀ x ∈ d'.support, x ∈ T

theorem mem_supported_iff' {T : Set σ} {f : MvPolynomial σ R} :
    f ∈ supported R T ↔ ∀ d ∈ f.support, ∀ x ∈ d.support, x ∈ T := by
  classical
  rw [mem_supported]
  constructor
  · intro h d hd x hx
    exact h ((mem_vars_iff_mem_support x).mpr ⟨d, hd, hx⟩)
  · intro h x hx
    obtain ⟨d, hd, hxd⟩ := (mem_vars_iff_mem_support x).mp hx
    exact h d hd x hxd

/-- If the leading monomial of `b` is in the variables `T` and the order eliminates outside `T`,
then `b` involves only the variables `T`. -/
theorem mem_supported_of_degree {T : Set σ} (hT : IsEliminationOrder m T) {f : MvPolynomial σ R}
    (hdeg : ∀ x ∈ (m.degree f).support, x ∈ T) : f ∈ supported R T :=
  mem_supported_iff'.mpr fun _ hd => hT _ _ hdeg (m.le_degree hd)

/-- **Elimination theorem.** If `b` is a Gröbner basis of `I` for an elimination order for `T`,
the elements of `b` that involve only the variables `T` form a Gröbner basis of `I ∩ R[T]`: every
nonzero `f ∈ I ∩ R[T]` has its leading monomial divisible by the leading monomial of some
`b i ∈ R[T]`. -/
theorem IsGroebnerBasis.elimination {ι : Type*} {b : ι → MvPolynomial σ R}
    {I : Ideal (MvPolynomial σ R)} (hG : IsGroebnerBasis m b I) {T : Set σ}
    (hT : IsEliminationOrder m T) {f : MvPolynomial σ R} (hfI : f ∈ I)
    (hfT : f ∈ supported R T) (hf0 : f ≠ 0) :
    ∃ i, b i ∈ supported R T ∧ m.degree (b i) ≤ m.degree f := by
  obtain ⟨i, hi⟩ := hG.2 f hfI hf0
  refine ⟨i, mem_supported_of_degree hT fun x hx => ?_, hi⟩
  have hdT := mem_supported_iff'.mp hfT _ ((m.degree_mem_support_iff f).mpr hf0)
  apply hdT
  rw [Finsupp.mem_support_iff] at hx ⊢
  exact Nat.pos_iff_ne_zero.mp (lt_of_lt_of_le (Nat.pos_of_ne_zero hx) (hi x))

/-- **Elimination theorem, generation form.** Under the hypotheses of `elimination`, with unit
leading coefficients, every `f ∈ I ∩ R[T]` lies in the ideal generated by the elements of `b` that
involve only `T`, with quotients whose products with the generators involve only `T`. -/
theorem IsGroebnerBasis.elimination_mem_span {ι : Type*} {b : ι → MvPolynomial σ R}
    {I : Ideal (MvPolynomial σ R)} (hG : IsGroebnerBasis m b I) {T : Set σ}
    (hT : IsEliminationOrder m T) (hb : ∀ i, IsUnit (m.leadingCoeff (b i)))
    {f : MvPolynomial σ R} (hfI : f ∈ I) (hfT : f ∈ supported R T) :
    f ∈ Ideal.span {p | p ∈ Set.range b ∧ p ∈ supported R T} := by
  classical
  -- divide by the subfamily in `R[T]`
  let J := {i : ι // b i ∈ supported R T}
  let bJ : J → MvPolynomial σ R := fun i => b i
  have hbJ : ∀ i, IsUnit (m.leadingCoeff (bJ i)) := fun i => hb i
  obtain ⟨g, r, hdiv, hdeg, hr⟩ := m.div hbJ f
  -- each product `b_i g_i` involves only `T`, hence so does the remainder
  have hprodT : ∀ i : J, bJ i * g i ∈ supported R T := by
    intro i
    refine mem_supported_iff'.mpr fun d hd x hx => ?_
    have hle : m.toSyn d ≤ m.toSyn (m.degree f) := (m.le_degree hd).trans (hdeg i)
    by_cases hf0 : f = 0
    · rw [hf0, m.degree_zero, map_zero] at hle
      have : d = 0 := (m.toSyn_eq_zero_iff d).mp (le_antisymm hle (m.zero_le _))
      simp [this] at hx
    · exact hT _ _ (mem_supported_iff'.mp hfT _ ((m.degree_mem_support_iff f).mpr hf0)) hle x hx
  have hlcT : Finsupp.linearCombination (MvPolynomial σ R) bJ g ∈ supported R T := by
    rw [Finsupp.linearCombination_apply]
    exact Subalgebra.sum_mem _ fun i _ => by
      dsimp only
      rw [smul_eq_mul, mul_comm]; exact hprodT i
  have hrT : r ∈ supported R T := by
    have : r = f - Finsupp.linearCombination (MvPolynomial σ R) bJ g := by rw [hdiv]; ring
    rw [this]; exact Subalgebra.sub_mem _ hfT hlcT
  -- the remainder is zero by the elimination theorem
  have hlcI : Finsupp.linearCombination (MvPolynomial σ R) bJ g ∈ I := by
    rw [Finsupp.linearCombination_apply]
    exact Submodule.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hG.1 i)
  have hrI : r ∈ I := by
    have : r = f - Finsupp.linearCombination (MvPolynomial σ R) bJ g := by rw [hdiv]; ring
    rw [this]; exact I.sub_mem hfI hlcI
  have hr0 : r = 0 := by
    by_contra hr0
    obtain ⟨i, hiT, hi⟩ := hG.elimination hT hrI hrT hr0
    exact hr _ ((m.degree_mem_support_iff r).mpr hr0) ⟨i, hiT⟩ hi
  rw [hdiv, hr0, add_zero, Finsupp.linearCombination_apply]
  exact Submodule.sum_mem _ fun i _ =>
    Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨⟨i.1, rfl⟩, i.2⟩)

/-- **Lexicographic order eliminates the smallest variables.** For a linear order on the variables
and an upward-closed set `T`, the lexicographic monomial order is an elimination order for `T`. -/
theorem lex_isEliminationOrder [LinearOrder σ] [WellFoundedGT σ] {T : Set σ}
    (hT : ∀ i j, i ≤ j → i ∈ T → j ∈ T) : IsEliminationOrder MonomialOrder.lex T := by
  intro d d' hd hle x hx
  by_contra hxT
  -- `d` vanishes at every variable `≤ x`
  have hd0 : ∀ y, y ≤ x → d y = 0 := by
    intro y hy
    by_contra h
    exact hxT (hT y x hy (hd y (Finsupp.mem_support_iff.mpr h)))
  have hne : toLex d ≠ toLex d' := by
    intro h
    have : d = d' := toLex.injective h
    rw [← this] at hx
    exact (Finsupp.mem_support_iff.mp hx) (hd0 x le_rfl)
  have hlt : toLex d' < toLex d := lt_of_le_of_ne hle (Ne.symm hne)
  obtain ⟨i, hi, hilt⟩ := Finsupp.Lex.lt_iff.mp hlt
  -- the first difference is at some `i`; compare with `x`
  rcases lt_or_ge x i with hxi | hix
  · -- before `i` they agree, so `d' x = d x = 0`
    have := hi x hxi
    simp only [ofLex_toLex] at this
    exact (Finsupp.mem_support_iff.mp hx) (this.trans (hd0 x le_rfl))
  · -- at `i ≤ x`, `d i = 0`, so `d' i < 0` is impossible
    have h0 := hd0 i hix
    simp only [ofLex_toLex] at hilt
    rw [h0] at hilt
    exact Nat.not_lt_zero _ hilt

/-- **Existence of Gröbner bases.** Over a field with finitely many variables, every ideal has a
finite Gröbner basis of nonzero polynomials, for every monomial order. The ideal generated by the
leading monomials of `I` is finitely generated (Hilbert's basis theorem); finitely many of the
spanning leading monomials already generate it, and the polynomials of `I` they come from form a
Gröbner basis. -/
theorem exists_isGroebnerBasis {K : Type*} [Field K] [Finite σ] (m : MonomialOrder σ)
    (I : Ideal (MvPolynomial σ K)) :
    ∃ s : Finset (MvPolynomial σ K),
      IsGroebnerBasis m (fun f : s => (f : MvPolynomial σ K)) I ∧ ∀ f ∈ s, f ≠ 0 := by
  classical
  set D : Set (σ →₀ ℕ) := {d | ∃ f ∈ I, f ≠ 0 ∧ m.degree f = d} with hD
  set mono : (σ →₀ ℕ) → MvPolynomial σ K := fun d => monomial d (1 : K) with hmono
  set L : Ideal (MvPolynomial σ K) := Ideal.span (mono '' D) with hL
  have : IsNoetherianRing (MvPolynomial σ K) := MvPolynomial.isNoetherianRing
  obtain ⟨G0, hG0⟩ := IsNoetherian.noetherian (L : Submodule (MvPolynomial σ K) (MvPolynomial σ K))
  have hT : ∀ g ∈ G0, ∃ T : Finset (MvPolynomial σ K), ↑T ⊆ mono '' D ∧
      g ∈ Submodule.span (MvPolynomial σ K) (T : Set (MvPolynomial σ K)) := by
    intro g hg
    have : g ∈ L := by rw [← hG0]; exact Submodule.subset_span hg
    exact Submodule.mem_span_finite_of_mem_span this
  choose T hTsub hTmem using hT
  set Tall : Finset (MvPolynomial σ K) := G0.attach.biUnion fun g => T g.1 g.2 with hTall
  have hP : ∀ p ∈ Tall, ∃ f ∈ I, f ≠ 0 ∧ mono (m.degree f) = p := by
    intro p hp
    obtain ⟨g, -, hpg⟩ := Finset.mem_biUnion.mp hp
    obtain ⟨d, ⟨f, hfI, hf0, rfl⟩, rfl⟩ := hTsub g.1 g.2 hpg
    exact ⟨f, hfI, hf0, rfl⟩
  choose F hFI hF0 hFmono using hP
  refine ⟨Tall.attach.image fun p => F p.1 p.2, ⟨?_, ?_⟩, ?_⟩
  · rintro ⟨f, hf⟩
    obtain ⟨p, -, rfl⟩ := Finset.mem_image.mp hf
    exact hFI _ _
  · intro f hfI hf0
    have hmemL : mono (m.degree f) ∈ L := Ideal.subset_span ⟨_, ⟨f, hfI, hf0, rfl⟩, rfl⟩
    have hLle : L ≤ Submodule.span (MvPolynomial σ K) (Tall : Set (MvPolynomial σ K)) := by
      rw [← hG0, Submodule.span_le]
      intro g hg
      refine Submodule.span_mono ?_ (hTmem g hg)
      intro p hp
      exact Finset.mem_biUnion.mpr ⟨⟨g, hg⟩, Finset.mem_attach _ _, hp⟩
    set E : Set (σ →₀ ℕ) := {e | ∃ p, ∃ hp : p ∈ Tall, m.degree (F p hp) = e} with hE
    have hTE : (Tall : Set (MvPolynomial σ K)) ⊆ mono '' E := by
      intro p hp
      exact ⟨_, ⟨p, hp, rfl⟩, hFmono p hp⟩
    have hmemE : mono (m.degree f) ∈ Ideal.span (mono '' E) :=
      Submodule.span_mono hTE (hLle hmemL)
    rw [hmono, mem_ideal_span_monomial_image] at hmemE
    obtain ⟨e, ⟨p, hp, rfl⟩, hle⟩ := hmemE (m.degree f) (by
      rw [support_monomial]; simp)
    exact ⟨⟨F p hp, Finset.mem_image.mpr ⟨⟨p, hp⟩, Finset.mem_attach _ _, rfl⟩⟩, hle⟩
  · intro f hf
    obtain ⟨p, -, rfl⟩ := Finset.mem_image.mp hf
    exact hF0 _ _

end Groebner

end CRNT
