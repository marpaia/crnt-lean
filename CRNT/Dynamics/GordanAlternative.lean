import Mathlib.Analysis.LocallyConvex.Separation
import Mathlib.Algebra.BigOperators.Ring.Finset

/-!
# Gordan's alternative on a coordinate set

`gordan_alternative`: for finitely many vectors `g i : S → ℝ` and a set `P` of coordinates, either
some nonnegative combination `∑ v i • g i` is strictly positive on every coordinate of `P`, or
some nonzero `w ≥ 0` supported in `P` has `⟨w, g i⟩ ≤ 0` for every `i`.

Proof: the set of vectors strictly positive on `P` is open and convex, the cone generated by the
`g i` is convex, and they are disjoint; `geometric_hahn_banach_open` separates them by a linear
functional, whose coefficient vector (negated) is `w`.  No closedness of the cone is needed.

Nothing here is an axiom or a `sorry`.
-/

open Finset

namespace CRNT

variable {S : Type} [DecidableEq S] [Fintype S]

/-- A linear functional on `S → ℝ` in coordinates. -/
theorem strongDual_apply_eq_sum (f : StrongDual ℝ (S → ℝ)) (x : S → ℝ) :
    f x = ∑ s, x s * f (Pi.single s 1) := by
  conv_lhs => rw [← Finset.univ_sum_single x]
  rw [map_sum]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [show (Pi.single s (x s) : S → ℝ) = x s • Pi.single s 1 by
    rw [← Pi.single_smul, smul_eq_mul, mul_one], map_smul, smul_eq_mul]

/-- **Gordan's alternative** restricted to the coordinates in `P`. -/
theorem gordan_alternative {ι : Type*} [Fintype ι] (g : ι → S → ℝ) (P : Finset S)
    (h : ¬ ∃ v : ι → ℝ, (∀ i, 0 ≤ v i) ∧ ∀ s ∈ P, 0 < ∑ i, v i * g i s) :
    ∃ w : S → ℝ, (∀ s, 0 ≤ w s) ∧ (∀ s, s ∉ P → w s = 0) ∧ (∃ s, 0 < w s) ∧
      ∀ i, ∑ s, w s * g i s ≤ 0 := by
  classical
  set O : Set (S → ℝ) := {x | ∀ s ∈ P, 0 < x s} with hO
  set K : Set (S → ℝ) := {b | ∃ v : ι → ℝ, (∀ i, 0 ≤ v i) ∧ b = ∑ i, v i • g i} with hK
  have hOc : Convex ℝ O := by
    intro x hx y hy a b ha hb hab s hs
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    rcases ha.eq_or_lt with rfl | ha'
    · simp at hab; subst hab; simpa using hy s hs
    · nlinarith [hx s hs, hy s hs]
  have hOo : IsOpen O := by
    have : O = ⋂ s ∈ P, {x : S → ℝ | 0 < x s} := by ext x; simp [hO]
    rw [this]
    exact isOpen_biInter_finset fun s _ => isOpen_lt continuous_const (continuous_apply s)
  have hKc : Convex ℝ K := by
    rintro x ⟨v, hv, rfl⟩ y ⟨v', hv', rfl⟩ a b ha hb _
    refine ⟨fun i => a * v i + b * v' i, fun i => by nlinarith [hv i, hv' i], ?_⟩
    simp only [smul_sum, smul_smul, ← sum_add_distrib, add_smul]
  have hdisj : Disjoint O K := by
    rw [Set.disjoint_left]
    rintro x hx ⟨v, hv, rfl⟩
    exact h ⟨v, hv, fun s hs => by simpa [Finset.sum_apply] using hx s hs⟩
  obtain ⟨f, u, hfO, hfK⟩ := geometric_hahn_banach_open hOc hOo hKc hdisj
  set c : S → ℝ := fun s => f (Pi.single s 1) with hc
  have hf : ∀ x, f x = ∑ s, x s * c s := strongDual_apply_eq_sum f
  have hu : u ≤ 0 := by
    have := hfK 0 ⟨0, fun _ => le_rfl, by simp⟩
    rwa [map_zero] at this
  -- the indicator of `P`, and points of `O`
  set one : S → ℝ := fun s => if s ∈ P then 1 else 0 with hone
  have hmemO : ∀ (μ : ℝ) (t : S), (t ∈ P → 0 ≤ μ) → one + μ • Pi.single t 1 ∈ O := by
    intro μ t hμ s hs
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hone, if_pos hs]
    by_cases hst : s = t
    · subst hst; simp; linarith [hμ hs]
    · simp [Pi.single_apply, hst]
  have hfpt : ∀ μ t, f (one + μ • Pi.single t 1) = f one + μ * c t := by
    intro μ t; rw [map_add, map_smul, smul_eq_mul]
  have hf1 : f one < u := hfO one fun s hs => by simp [hone, hs]
  -- `f` is nonnegative on every generator
  have hgi : ∀ i, 0 ≤ f (g i) := by
    intro i
    by_contra hneg
    push Not at hneg
    set lam := (1 - u) / (-f (g i)) with hlam
    have hlampos : 0 < lam := div_pos (by linarith) (by linarith)
    have hmem : lam • g i ∈ K := by
      refine ⟨fun j => if j = i then lam else 0, fun j => ?_, ?_⟩
      · show 0 ≤ (if j = i then lam else 0)
        split_ifs <;> linarith
      simp [ite_smul]
    have h1 := hfK _ hmem
    rw [map_smul, smul_eq_mul] at h1
    have h2 : lam * f (g i) = -(1 - u) := by
      rw [hlam, div_mul_eq_mul_div, div_eq_iff (by linarith)]; ring
    linarith
  -- coefficients vanish off `P` and are nonpositive on `P`
  have hcoff : ∀ t, t ∉ P → c t = 0 := by
    intro t ht
    by_contra hne
    have h := hfO _ (hmemO ((u - f one) / c t) t (fun h => absurd h ht))
    rw [hfpt, div_mul_cancel₀ _ hne] at h
    linarith
  have hcP : ∀ t ∈ P, c t ≤ 0 := by
    intro t ht
    by_contra hpos
    push Not at hpos
    have h := hfO _ (hmemO ((u - f one) / c t) t (fun _ => div_nonneg (by linarith) hpos.le))
    rw [hfpt, div_mul_cancel₀ _ hpos.ne'] at h
    linarith
  have hneg : ∃ s, c s < 0 := by
    by_contra hall
    push Not at hall
    have : 0 ≤ f one := by
      rw [hf]
      exact sum_nonneg fun s _ => mul_nonneg (by simp only [hone]; split_ifs <;> norm_num)
        (hall s)
    linarith
  refine ⟨fun s => -c s, fun s => ?_, fun s hs => by simp [hcoff s hs], ?_, fun i => ?_⟩
  · by_cases hs : s ∈ P
    · linarith [hcP s hs]
    · simp [hcoff s hs]
  · obtain ⟨s, hs⟩ := hneg; exact ⟨s, by linarith⟩
  · have := hgi i
    rw [hf] at this
    have e : ∑ s, -c s * g i s = -∑ s, g i s * c s := by
      rw [← sum_neg_distrib]; exact sum_congr rfl fun s _ => by ring
    rw [e]; linarith

end CRNT
